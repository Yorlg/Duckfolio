# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# 依赖
/node_modules
/.pnpm-store/
/.pnp
.pnp.js
/.yarn

# 测试
/coverage

# Next.js
/.next/
/out/

# 生产环境
/build

# 其他
.DS_Store
*.pem

# 调试
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 本地环境变量
.env
.env.*
!.env.example
.env*.local

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# WebStorm
.idea

# 内容数据 - main 分支忽略，deploy 分支需要包含
/posts/
/photos/

# Local Codex dev server logs
.codex-next-dev.*

# 部署分支保留照片内容，覆盖开发分支的目录忽略规则
!/photos/
!/photos/**
