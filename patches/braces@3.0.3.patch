diff --git a/lib/assert-depth.js b/lib/assert-depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..867dbc0ab5e87ec43f337e53f639cdd1eb47e334
--- /dev/null
+++ b/lib/assert-depth.js
@@ -0,0 +1,33 @@
+'use strict';
+
+const MAX_DEPTH = 128;
+
+// Check child edges only: parser-created parent/prev links are intentionally cyclic.
+const assertDepth = ast => {
+  const stack = [{ node: ast, depth: 0, index: 0 }];
+  const ancestors = new Set([ast]);
+
+  while (stack.length > 0) {
+    const frame = stack[stack.length - 1];
+    const children = frame.node.nodes;
+    if (!children || frame.index === children.length) {
+      ancestors.delete(frame.node);
+      stack.pop();
+      continue;
+    }
+
+    const child = children[frame.index++];
+    const depth = frame.depth + 1;
+    if (depth > MAX_DEPTH) {
+      throw new SyntaxError(`Brace AST exceeds safe depth of ${MAX_DEPTH}`);
+    }
+    if (ancestors.has(child)) {
+      throw new SyntaxError('Brace AST must be acyclic');
+    }
+    ancestors.add(child);
+    stack.push({ node: child, depth, index: 0 });
+  }
+};
+
+module.exports = assertDepth;
+module.exports.MAX_DEPTH = MAX_DEPTH;
